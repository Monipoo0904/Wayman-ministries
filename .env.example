# Copy to .env.local for local development, and add the same values in
# Vercel → Project → Settings → Environment Variables.

# ── Online giving & event tickets (Stripe) ─────────────────────────────
# From https://dashboard.stripe.com/apikeys (use sk_test_/pk_test_ keys to try it out).
# Until these are set, the Give button links to the church's existing Vanco page.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── Registration emails (Resend) ───────────────────────────────────────
# From https://resend.com/api-keys. Until set, forms ask people to email the church.
RESEND_API_KEY=
# Sender address. Must be on a domain verified in Resend (e.g. wayman.org).
REGISTRATION_FROM_EMAIL="Wayman Temple <noreply@wayman.org>"
# Where registrations are delivered. Defaults to temple@wayman.org.
REGISTRATION_TO_EMAIL=
